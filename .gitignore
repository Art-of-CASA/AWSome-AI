# Local environment files may contain API keys or developer-only credentials.
.env
.env.*
!.env.example

# AWS local credentials and profiles
.aws/

# Node / Python build outputs
node_modules/
dist/
build/
.venv/
__pycache__/
*.py[cod]

# Test, coverage, editor, and operating-system files
.coverage
coverage/
.pytest_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db

# CDK-generated files
cdk.out/

# Local tool settings and deployment packages
.claude/
*.zip

# Organizer briefing documents (shared separately by PolyFinances; the starter data stays tracked)
Datathon2026/*.pdf
Datathon2026/*.pptx

# Cache des mots-clés dynamiques créés par l'agent chercheur (propre à chaque serveur)
mvp_profil/cache/

# Journal local des actions de la recommandation (propre à chaque machine)
mvp_profil/traces/
traces/

# Fichiers de travail locaux (audits, extraits) : jamais versionnés
tmp/
